# PostgreSQL Connection URL
# Local Docker development: postgresql://jobhub:jobhub_password@localhost:5432/jobhub_dev
# Production (Neon): postgresql://<user>:<password>@<neon-hostname>/<dbname>?sslmode=require
DATABASE_URL=postgresql://jobhub:jobhub_password@localhost:5432/jobhub_dev

# Better Auth Configuration
# Secret key used to encrypt and sign session tokens (min 32 characters)
BETTER_AUTH_SECRET=your-better-auth-secret-min-32-chars
# Base URL of the web application
BETTER_AUTH_URL=http://localhost:3000
